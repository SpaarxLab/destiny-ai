# Embedded lab assistant (optional, server-side, replaceable proposal source; see docs/DECISIONS.md D-014).
# Default is disabled: the product, the WebMCP path, and every test run without a model or key.
# When enabled, the browser sends the participant's confirmed words to this server only after the
# participant explicitly asks the lab assistant for a proposal; the server drafts, grounds, and
# returns a typed proposal and never writes to the workspace.
# Keep this disabled on a public deployment unless the proposal endpoint is protected by
# authenticated, rate-limited infrastructure; otherwise callers could spend the provider quota.
#
# LAB_ASSISTANT_PROVIDER: disabled (default) | openai_compatible | fake
#   fake is a deterministic in-process double for tests and local demos (labelled "Lab assistant (test double)").
LAB_ASSISTANT_PROVIDER=disabled

# Any OpenAI-compatible chat-completions endpoint works (OpenCode Go, vLLM, Ollama, LM Studio, a
# hosted gateway): base URL + key + model. Required when LAB_ASSISTANT_PROVIDER=openai_compatible.
LAB_ASSISTANT_BASE_URL=
LAB_ASSISTANT_API_KEY=
LAB_ASSISTANT_MODEL=

# Human-facing label shown next to assistant proposals. Defaults to "Lab assistant".
LAB_ASSISTANT_LABEL=Lab assistant

# The Deck's optional server-side proposal roles. The fixture Deck is the default and complete
# experience. Enable only on a protected deployment and never commit the key.
EMBEDDED_ROLES=off
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
ROLE_MODEL_DEALER=glm-5.3-flash
ROLE_MODEL_READER=qwen3.8-flash
ROLE_MODEL_SKEPTIC=deepseek-v4-flash
ROLE_MODEL_ROUTEMAKER=gpt-5.6-luna
ROLE_MODEL_FALLBACK=qwen3.8-flash
ROLE_MODEL_JUDGE=deepseek-v4-flash
DEALER_DAILY_BUDGET_USD=3
